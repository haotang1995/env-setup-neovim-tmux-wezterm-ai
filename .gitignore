# macOS
.DS_Store

# Neovim
nvim-config/.neoconf.json
nvim-config/plugin/

# lazy.nvim state
nvim-config/lazy-lock.json
nvim-config/lazy-lock.json.bak

# Neovim swap / undo / shada
*.swp
*.swo
*~

# Node (markdown-preview.nvim build artifacts)
node_modules/

# Python
__pycache__/

# Environment / secrets
.env
.env.*

# Machine-local shell secrets / per-host env (sourced by zshrc + bashrc).
# Defensive: this file lives at ~/.shellrc.local, not in the repo, but if
# anyone ever drops one here by mistake it must not be committed.
.shellrc.local
.shellrc.local.*

# Agent auth tokens (may contain OAuth credentials)
.copilot/config.json

# Windows-side WezTerm copy (produced by install.sh on WSL)
.wezterm.lua

# Git worktrees
.worktrees/

# Editor / IDE
.vscode/
.idea/
*.code-workspace

# Claude Code runtime state
.claude/scheduled_tasks.lock

# GCR kubectl-duc plugin artifacts (internal MSR tooling from the ADO wiki).
# Download per-machine; not redistributed via this repo. Installed with
# `kduc-install` (see k_shortcuts.sh).
kubectl-dev/
