# ~/.shellrc.local — machine-local shell config (GITIGNORED, NOT IN REPO).
# Sourced by both ~/.zshrc and ~/.bashrc at the very end.
#
# Put here:
#   - API tokens / credentials       (WANDB_KEY, HF_TOKEN, OPENAI_API_KEY, ...)
#   - Per-host PATH adjustments      (HPC module dirs, ~/.krew/bin, conda, ...)
#   - Work-only or project-specific  env vars
#   - Anything you do NOT want committed to the dotfiles repo
#
# Permissions should be 600 (chmod 600 ~/.shellrc.local).
# install.sh auto-creates this file and migrates known secret-ish exports
# (WANDB_KEY, HF_TOKEN, KREW PATH, etc.) from any pre-existing ~/.zshrc / ~/.bashrc
# on first run.

# --- examples ---
# export WANDB_KEY=...
# export HF_TOKEN=...
# export OPENAI_API_KEY=...
# export ANTHROPIC_API_KEY=...
# export PATH="${KREW_ROOT:-$HOME/.krew}/bin:$PATH"
# export PATH="$HOME/miniconda3/bin:$PATH"

# --- local Copilot proxy (copilot-proxy) ---
# Auto-generated on first `copilot-proxy start`; you normally don't set these
# by hand. COPILOT_PROXY_KEY gates the local endpoint — without it the proxy
# would serve anyone who can reach the port.
# export COPILOT_PROXY_KEY=ck-...
# export COPILOT_PROXY_URL=http://127.0.0.1:6868
#
# For direct SDK use against the proxy's /v1 surface, prefer scoping the
# override to the call site rather than exporting OPENAI_BASE_URL globally
# (that would silently redirect every other OpenAI client on the machine):
#   eval "$(copilot-proxy env --openai)"      # this shell only
#   eval "$(copilot-proxy env --anthropic)"   # this shell only
